rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES AUXILIARES CON CUSTOM CLAIMS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    // El staff debe estar autenticado con credenciales reales (no anónimo)
    function isStaff() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Validación basada en Custom Claims (request.auth.token.rol)
    function hasRole(rol) {
      return isStaff() && request.auth.token.rol == rol;
    }

    function isAdmin() {
      return hasRole('Administración');
    }
    
    function isMedico() {
      return hasRole('Médico');
    }
    
    function isRecepcion() {
      return hasRole('Recepción') || hasRole('Recepcionista') || hasRole('Administrativo');
    }

    // ==========================================
    // REGLAS POR COLECCIÓN
    // ==========================================

    // ------- Perfiles de usuario -------
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isRecepcion() || isMedico());
      allow write: if isAdmin();
    }

    // ------- Turnos -------
    match /turnos/{turnoId} {
      allow read: if isStaff();
      allow create: if isRecepcion() || isAdmin();
      allow update: if isAdmin() 
        || isRecepcion() 
        || (isMedico() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'evolucionMedica', 'motivoConsulta']));
      allow delete: if isAdmin() || isRecepcion();
    }

    // ------- Modulación individual por médico -------
    match /modulacion_medicos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------- Configuración / Modulación General -------
    match /configuracion/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // ==========================================
    // CIERRE POR DEFECTO (DENEGAR TODO LO DEMÁS)
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
