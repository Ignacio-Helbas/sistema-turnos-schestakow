rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES AUXILIARES DE AUTORIZACIÓN
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserRol() {
      return request.auth.token.get('rol', 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', '') : ''
      );
    }

    function isSuperAdmin() {
      return isStaff() && getUserRol() == 'Administración';
    }

    function isRecepcion() {
      return isStaff() && (
        getUserRol() in ['Recepción', 'Recepcionista', 'Administrativo', 'Administración']
      );
    }

    function isMedico() {
      return isStaff() && getUserRol() == 'Médico';
    }

    function hasPacienteAcceso(pacienteId) {
      return exists(/databases/$(database)/documents/pacientes/$(pacienteId)/acceso/$(request.auth.uid));
    }

    // ==========================================
    // REGLAS: PERFILES DE USUARIOS
    // ==========================================
    match /usuarios/{uid} {
      allow get: if isStaff() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isStaff() && (isSuperAdmin() || request.auth.uid == uid);
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // REGLAS: MÉDICOS PÚBLICOS
    // ==========================================
    match /medicos_publicos/{medicoUid} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // REGLAS: TURNOS (Sin datos clínicos)
    // ==========================================
    function isValidTurnoCreate() {
      let data = request.resource.data;
      let allowedKeys = [
        'especialidad', 'medico', 'medicoUid', 'fecha', 'horario',
        'pacienteNombre', 'pacienteDni', 'pacienteCelular', 'pacienteEmail',
        'codigoConfirmacion', 'canal', 'estado', 'timestamp', 'creadoEn',
        'creadoPor', 'llegadaEn', 'inicioConsultaEn', 'finConsultaEn',
        'canceladoPor', 'canceladoEn', 'reprogramadoDe'
      ];
      return data.keys().hasOnly(allowedKeys)
        && data.especialidad is string && data.especialidad.size() > 0 && data.especialidad.size() <= 100
        && data.medico is string && data.medico.size() > 0 && data.medico.size() <= 100
        && data.medicoUid is string && data.medicoUid.size() > 0 && data.medicoUid.size() <= 128
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.horario is string && data.horario.matches('^[0-9]{2}:[0-9]{2}$')
        && data.pacienteNombre is string && data.pacienteNombre.size() >= 2 && data.pacienteNombre.size() <= 100
        && data.pacienteDni is string && data.pacienteDni.matches('^[0-9]{6,10}$')
        && data.pacienteCelular is string && data.pacienteCelular.size() >= 6 && data.pacienteCelular.size() <= 25
        && data.pacienteEmail is string && data.pacienteEmail.size() <= 100
        && data.codigoConfirmacion is string && data.codigoConfirmacion.size() >= 6 && data.codigoConfirmacion.size() <= 64
        && data.canal == 'Web'
        && data.estado == 'Confirmado'
        && (!('creadoPor' in data) || data.creadoPor == null)
        && (
          ('creadoEn' in data && data.creadoEn == request.time) ||
          ('timestamp' in data && data.timestamp == request.time)
        );
    }

    function isValidTurnoStaffCreate() {
      let data = request.resource.data;
      let allowedKeys = [
        'especialidad', 'medico', 'medicoUid', 'fecha', 'horario',
        'pacienteNombre', 'pacienteDni', 'pacienteCelular', 'pacienteEmail',
        'codigoConfirmacion', 'canal', 'estado', 'timestamp', 'creadoEn', 'pacienteId',
        'motivoCitacion', 'modoHorario', 'creadoPor', 'llegadaEn', 'inicioConsultaEn',
        'finConsultaEn', 'canceladoPor', 'canceladoEn', 'reprogramadoDe', 'esDemo', 'demo'
      ];
      return (isSuperAdmin() || isRecepcion() || isMedico())
        && data.keys().hasOnly(allowedKeys)
        && data.especialidad is string && data.especialidad.size() > 0 && data.especialidad.size() <= 100
        && data.medico is string && data.medico.size() > 0 && data.medico.size() <= 100
        && data.medicoUid is string && data.medicoUid.size() > 0 && data.medicoUid.size() <= 128
        && data.fecha is string && data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (data.horario.matches('^[0-9]{2}:[0-9]{2}$') || data.horario in ['Pendiente', 'Por Paciente'])
        && data.pacienteNombre is string && data.pacienteNombre.size() >= 2 && data.pacienteNombre.size() <= 100
        && data.pacienteDni is string && data.pacienteDni.matches('^[0-9]{6,10}$')
        && data.pacienteCelular is string && data.pacienteCelular.size() >= 6 && data.pacienteCelular.size() <= 25
        && data.canal in ['Presencial', 'Telefónico', 'Web', 'Consultorio', 'Seguimiento', 'Médico']
        && (
          data.estado in ['Confirmado', 'Confirmado Presencial', 'Pendiente de Horario']
          || (isSuperAdmin() && data.estado in ['En Espera', 'Atendido', 'En Consultorio', 'Ausente', 'Cancelado', 'Cancelado por Paciente'])
        );
    }

    match /turnos/{turnoId} {
      allow get: if isSuperAdmin()
        || isRecepcion()
        || (isMedico() && resource.data.medicoUid == request.auth.uid)
        || (!isSignedIn() && turnoId.size() >= 16);

      allow list: if isSuperAdmin()
        || isRecepcion()
        || (isMedico() && resource.data.medicoUid == request.auth.uid);

      allow create: if (turnoId.size() >= 16 && isValidTurnoCreate())
        || isValidTurnoStaffCreate();

      // En turnos solo se gestionan estados operativos y vinculación a pacienteId.
      // Toda evolución médica fue desacoplada a pacientes/{pacienteId}/consultas/
      // Regla Fase 1: Nadie puede modificar creadoEn ni creadoPor después de creado.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creadoEn', 'creadoPor'])
        && (
          isSuperAdmin()
          || (
            isRecepcion()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estado', 'horario', 'fecha', 'pacienteId', 'llegadaEn', 'canceladoPor', 'canceladoEn', 'reprogramadoDe'
            ])
            && (!('canceladoPor' in request.resource.data) || request.resource.data.canceladoPor in ['recepcion', 'paciente', null])
          )
          || (
            isMedico()
            && resource.data.medicoUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'estado', 'atendidoEn', 'pacienteId', 'horario', 'fecha', 'inicioConsultaEn', 'finConsultaEn', 'canceladoPor', 'canceladoEn'
            ])
            && (!('canceladoPor' in request.resource.data) || request.resource.data.canceladoPor in ['medico', null])
          )
          || (
            !isSignedIn()
            && turnoId.size() >= 16
            && resource.data.estado == 'Pendiente de Horario'
            && request.resource.data.estado == 'Confirmado'
            && request.resource.data.horario.matches('^[0-9]{2}:[0-9]{2}$')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['horario', 'estado', 'confirmadoEn', 'codigoConfirmacion', 'timestamp'])
          )
          || (
            !isSignedIn()
            && turnoId.size() >= 16
            && resource.data.estado in ['Confirmado', 'Pendiente de Horario']
            && request.resource.data.estado == 'Cancelado por Paciente'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEn', 'canceladoPor'])
            && request.resource.data.canceladoEn == request.time
            && request.resource.data.canceladoPor == 'paciente'
          )
        );

      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // REGLAS: DISPONIBILIDAD
    // ==========================================
    match /disponibilidad/{slotId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/disponibilidad/$(slotId))
        && request.resource.data.keys().hasOnly(['medicoUid', 'fecha', 'horario', 'creadoEn'])
        && request.resource.data.creadoEn == request.time;
      allow delete: if isSuperAdmin() || isRecepcion()
        || (!isSignedIn() && request.time != null);
    }

    // ==========================================
    // REGLAS: HISTORIA CLÍNICA (MODELO SEGURO E INMUTABLE)
    // ==========================================

    // 1. Pacientes (Solo datos demográficos)
    match /pacientes/{pacienteId} {
      // Recepción y médicos leen datos demográficos
      allow read: if isStaff();
      
      // Creación y edición demográfica por staff
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'dni', 'nombre', 'apellido', 'fechaNacimiento', 'sexo',
          'contacto', 'creadoEn', 'creadoPor', 'esDemo', 'actualizadoEn'
        ])
        && request.resource.data.dni is string
        && request.resource.data.dni.matches('^[0-9]{6,10}$')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.apellido is string
        && request.resource.data.apellido.size() > 0;

      allow delete: if isSuperAdmin();

      // 2. Resumen clínico (Alergias, antecedentes, medicación)
      match /clinico/{docId} {
        // Solo médicos con acceso o administración
        allow read: if isSuperAdmin() || (isMedico() && hasPacienteAcceso(pacienteId));
        allow write: if isSuperAdmin() || (isMedico() && hasPacienteAcceso(pacienteId));
      }

      // 3. Consultas (Evolución médica - TOTALMENTE INMUTABLE)
      match /consultas/{consultaId} {
        allow read: if isSuperAdmin() || (isMedico() && hasPacienteAcceso(pacienteId));

        // Create: solo médico con acceso habilitado para este paciente
        allow create: if isSuperAdmin() || (
          isMedico()
          && hasPacienteAcceso(pacienteId)
          && request.resource.data.medicoUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'turnoId', 'medicoUid', 'medicoNombre', 'fecha',
            'motivo', 'evolucion', 'indicaciones', 'diagnostico',
            'diagnosticoCodigo', 'signosVitales', 'corrige'
          ])
          && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 1000
          && request.resource.data.evolucion is string && request.resource.data.evolucion.size() <= 10000
          && request.resource.data.indicaciones is string && request.resource.data.indicaciones.size() <= 5000
          && request.resource.data.fecha == request.time
        );

        // INMUTABILIDAD: Nunca se pueden editar ni borrar consultas
        allow update, delete: if false;
      }

      // 4. Acceso habilitado a la historia clínica para profesionales
      match /acceso/{medicoUid} {
        allow read: if isSuperAdmin() || (isMedico() && request.auth.uid == medicoUid);
        
        // El médico solo puede crear acceso si:
        // A) Tiene turno legítimo asignado con ese paciente
        // B) Es una emergencia declarada con motivo >= 10 caracteres
        // C) SuperAdmin
        allow create: if isSuperAdmin() || (
          isMedico()
          && request.auth.uid == medicoUid
          && (
            ('turnoId' in request.resource.data && request.resource.data.turnoId is string)
            || (request.resource.data.get('motivoEmergencia', '').size() >= 10)
          )
        );

        allow update, delete: if isSuperAdmin();
      }
    }

    // Índice determinista de unicidad de pacientes por DNI
    match /pacientes_por_dni/{dni} {
      allow read: if isStaff();
      allow create: if isStaff()
        && !exists(/databases/$(database)/documents/pacientes_por_dni/$(dni))
        && request.resource.data.keys().hasOnly(['pacienteId', 'dni', 'creadoEn']);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // REGLAS: AUDITORÍA (APPEND-ONLY)
    // ==========================================
    match /auditoria/{auditId} {
      allow read: if isSuperAdmin();
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.fecha == request.time
        && request.resource.data.keys().hasOnly([
          'actorUid', 'actorRol', 'accion', 'pacienteId',
          'consultaId', 'fecha', 'detalle'
        ]);
      allow update, delete: if false;
    }

    // ==========================================
    // REGLAS: CONFIGURACIÓN Y MODULACIÓN
    // ==========================================
    match /modulacion_medicos/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /configuracion/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // CIERRE POR DEFECTO TOTAL
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
