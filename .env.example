# Firebase Client SDK (Configuración Web pública - Protegida por HTTP Referrers en GCP)
VITE_FIREBASE_API_KEY=AIzaSy_REEMPLAZAR_CON_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=sistema-turnos-utn.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sistema-turnos-utn
VITE_FIREBASE_STORAGE_BUCKET=sistema-turnos-utn.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=588893912264
VITE_FIREBASE_APP_ID=1:588893912264:web:c5d56455f06cf178d979fd

# EmailJS Service (Exclusivo para backend / Cloud Functions)
# Estas credenciales NUNCA deben exponerse en el código del frontend
EMAILJS_SERVICE_ID=service_xxxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here
EMAILJS_TEMPLATE_CONFIRMACION=template_confirmacion
EMAILJS_TEMPLATE_CANCELACION=template_cancelacion

# reCAPTCHA / Firebase App Check (Anti-Bot)
VITE_RECAPTCHA_SITE_KEY=6L_REEMPLAZAR_CON_SITE_KEY
